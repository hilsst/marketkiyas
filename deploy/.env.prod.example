# Kopyala: cp deploy/.env.prod.example .env  (bu dosyayı ASLA git'e ekleme)
DOMAIN=api.ornek.com
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32
JWT_SECRET_KEY=
CORS_ORIGINS=https://ornek.com
API_WORKERS=2
BACKUP_KEEP_DAYS=14

# Haftalık menü push bildirimi (APK ile gerçek telefonda test ettikten sonra true yap)
EXPO_PUSH_ENABLED=false

# Şifre sıfırlama e-postası (boşsa kod yalnız sunucu günlüğüne yazılır)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Ucuzu <no-reply@ucuzu.app>

# Google ile giriş, virgülle ayrılmış OAuth istemci kimlikleri
GOOGLE_CLIENT_IDS=
# Analitik rapor ucu için (boşsa kapalı): openssl rand -hex 16
ANALYTICS_TOKEN=
