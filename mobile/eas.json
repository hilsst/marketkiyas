{
  "cli": { "version": ">= 13.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_ADS": "test" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://API_ALAN_ADI/api",
        "EXPO_PUBLIC_ADS": "test"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://API_ALAN_ADI/api",
        "EXPO_PUBLIC_ADS": "test"
      }
    }
  },
  "submit": {
    "production": { "android": { "track": "internal", "releaseStatus": "draft" } }
  }
}
